# Copy to .env.local (gitignored) and fill in.
# VATSIM OAuth client secret matching CLIENT_ID (dev client 682 by default).
CLIENT_SECRET=

# YouTube URL for Flight → STRIPVIEW → ESGG (GET /striptv/esgg).
# Paste watch, studio, youtu.be, or embed — missing embed params are filled in.
# Example: https://www.youtube.com/watch?v=VIDEO_ID
STRIPVIEW_ESGG_SRC=
